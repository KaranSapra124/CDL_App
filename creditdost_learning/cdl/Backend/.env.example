# Copy to .env and fill in. .env is git-ignored; never commit real values.
API_ADDR=:8080
DATABASE_URL=postgres://creditdost:local_dev_password@localhost:5432/creditdost_learning?sslmode=disable
# At least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-string-of-32-plus-chars
# true in production (HTTPS). false only for plain-http local testing.
COOKIE_SECURE=false
